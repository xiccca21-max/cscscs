# ── БАЗА ДАННЫХ ──
# Подключение через пул (для приложения). Используется в рантайме.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cs_ne_go?schema=public"
# Прямое подключение (для Prisma CLI: db push, migrate, studio)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cs_ne_go?schema=public"

# ── STEAM ──
# Ключ Steam Web API — получить тут: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""
# Ключи SteamApis.com (прокси инвентаря, обход лимитов) — https://steamapis.com
# Основной ключ (CS2). Если игровой ключ не задан, используется этот.
STEAMAPIS_KEY=""
# Отдельные ключи для каждой игры (опционально)
STEAMAPIS_KEY_DOTA2=""
STEAMAPIS_KEY_TF2=""
STEAMAPIS_KEY_RUST=""

# ── АВТОРИЗАЦИЯ ──
# Пароль для шифрования сессий. Минимум 32 символа. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=""

# ── ПРИЛОЖЕНИЕ ──
# Публичный URL сайта (без слеша в конце)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── АДМИН ──
# Steam64 ID администраторов через запятую. Узнать свой: https://steamid.io
ADMIN_STEAM_IDS=""
