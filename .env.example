# База данных
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cs_ne_go?schema=public"
# Для команд Prisma (db push, migrate). На одном сервере с одной БД обычно как DATABASE_URL
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cs_ne_go?schema=public"

# Steam Web API: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""
# SteamApis (инвентарь Steam для всех игр): https://docs.steamapis.com/steam/inventory — один ключ на аккаунт
STEAMAPIS_KEY=""

# TM Market: приватный API-ключ из кабинета маркета по каждой игре (market.csgo.com, market.dota2.net, tf2.tm, rust.tm).
# Документация: ключ в query ?key=... или заголовок X-API-KEY. Без ключа публичный prices/USD.json может быть доступен с ограничениями.
TM_MARKET_API_KEY_CS2=""
TM_MARKET_API_KEY_DOTA2=""
TM_MARKET_API_KEY_TF2=""
TM_MARKET_API_KEY_RUST=""

# Сессии: минимум 32 символа, например openssl rand -hex 32
SESSION_SECRET=""

# Публичный URL сайта без слэша в конце
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Пример: Meta (Facebook) Pixel — только цифры ID из Events Manager. Пусто = скрипт не грузится.
# В Docker NEXT_PUBLIC_* попадает в бандл на этапе build; см. build.args в docker-compose.yml.
NEXT_PUBLIC_META_PIXEL_ID=""

# Админы: steamID64 через запятую — https://steamid.io
ADMIN_STEAM_IDS=""
