# ── DATABASE ──
# Pooled connection (for app runtime). Used by the app.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cs_ne_go?schema=public"
# Direct connection (for Prisma CLI: db push, migrate, studio)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cs_ne_go?schema=public"

# ── STEAM ──
# Steam Web API Key — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""
# SteamApis.com key (inventory proxy, bypasses rate limits) — https://steamapis.com
STEAMAPIS_KEY=""

# ── AUTH ──
# iron-session password. Min 32 chars. Generate: openssl rand -hex 32
SESSION_SECRET=""

# ── APP ──
# Public URL of the deployed site (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── ADMIN ──
# Comma-separated Steam64 IDs that get admin access after login
ADMIN_STEAM_IDS=""
